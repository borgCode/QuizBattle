          }
        }
      },
      "PlayerQuestionResult": {
        "type": "object",
        "properties": {
          "playerId": {
            "type": "integer",
            "format": "int64"
          },
          "questionId": {
            "type": "integer",
            "format": "int64"
          },
          "questionIndex": {
            "type": "integer",
            "format": "int32"
          },
          "correct": {
            "type": "boolean"
          }
        }
