{
  "openapi": "3.0.1",
  "info": {
    "title": "Your API Title",
    "description": "Your API Description",
    "version": "1.0"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Generated server url"
    }
  ],
  "paths": {
    "/user/update": {
      "put": {
        "tags": [
          "User"
        ],
        "operationId": "updateUser",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateUserRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/questions/validate-answer": {
      "post": {
        "tags": [
          "Questions"
        ],
        "operationId": "validateAnswer",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnswerValidationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnswerValidationResponse"
                }
              }
            }
          }
        }
      }
    },
    "/multiplayer/matchmaking": {
      "post": {
        "tags": [
          "Multiplayer"
        ],
        "operationId": "findMatch",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MatchmakingRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MatchmakingResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/register": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "operationId": "register",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegistrationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/auth/authenticate": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "operationId": "authenticate",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/user/{username}": {
      "get": {
        "tags": [
          "User"
        ],
        "operationId": "getUserById",
        "parameters": [
          {
            "name": "username",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          }
        }
      }
    },
    "/questions/{category}": {
      "get": {
        "tags": [
          "Questions"
        ],
        "operationId": "getThreeQuestionsByCategory",
        "parameters": [
          {
            "name": "request",
            "in": "query",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/CategorySelectionRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/QuestionDTO"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/questions/session/{sessionId}": {
      "get": {
        "tags": [
          "Questions"
        ],
        "operationId": "getSessionQuestions",
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/QuestionDTO"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/multiplayer/session/{sessionId}": {
      "get": {
        "tags": [
          "Multiplayer"
        ],
        "operationId": "getGameState",
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameStateResponse"
                }
              }
            }
          }
        }
      }
    },
    "/multiplayer/matchmaking/{playerId}": {
      "delete": {
        "tags": [
          "Multiplayer"
        ],
        "operationId": "cancelMatchmaking",
        "parameters": [
          {
            "name": "playerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "UpdateUserRequest": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "integer",
            "format": "int64"
          },
          "updateField": {
            "type": "string",
            "enum": [
              "USERNAME",
              "DISPLAY_NAME"
            ]
          },
          "newUsername": {
            "type": "string"
          },
          "newDisplayName": {
            "type": "string"
          }
        }
      },
      "AnswerValidationRequest": {
        "type": "object",
        "properties": {
          "questionId": {
            "type": "integer",
            "format": "int64"
          },
          "sessionId": {
            "type": "integer",
            "format": "int64"
          },
          "answer": {
            "type": "string"
          },
          "playerId": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "AnswerValidationResponse": {
        "type": "object",
        "properties": {
          "correct": {
            "type": "boolean"
          },
          "gameStateUpdate": {
            "$ref": "#/components/schemas/GameStateUpdate"
          }
        }
      },
      "GameStateUpdate": {
        "type": "object",
        "properties": {
          "currentQuestionIndex": {
            "type": "integer",
            "format": "int32"
          },
          "scores": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "format": "int32"
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "COMPLETED"
            ]
          },
          "isOpponentTurn": {
            "type": "boolean"
          }
        }
      },
      "MatchmakingRequest": {
        "type": "object",
        "properties": {
          "playerId": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "MatchmakingResponse": {
        "type": "object",
        "properties": {
          "matchStatus": {
            "type": "string",
            "enum": [
              "WAITING",
              "MATCHED",
              "CANCELLED",
              "ERROR",
              "TIMEOUT"
            ]
          },
          "sessionId": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "RegistrationRequest": {
        "required": [
          "displayName",
          "password",
          "username"
        ],
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          }
        }
      },
      "AuthRequest": {
        "required": [
          "password",
          "username"
        ],
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "AuthResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "userDTO": {
            "$ref": "#/components/schemas/UserDTO"
          },
          "token": {
            "type": "string"
          }
        }
      },
      "UserDTO": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "numOfGames": {
            "type": "integer",
            "format": "int32"
          },
          "numOfWins": {
            "type": "integer",
            "format": "int32"
          },
          "numOfLosses": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "GrantedAuthority": {
        "type": "object",
        "properties": {
          "authority": {
            "type": "string"
          }
        }
      },
      "Role": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "numOfGames": {
            "type": "integer",
            "format": "int32"
          },
          "numOfWins": {
            "type": "integer",
            "format": "int32"
          },
          "numOfLosses": {
            "type": "integer",
            "format": "int32"
          },
          "accountLocked": {
            "type": "boolean"
          },
          "enabled": {
            "type": "boolean"
          },
          "roles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Role"
            }
          },
          "authorities": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GrantedAuthority"
            }
          },
          "accountNonExpired": {
            "type": "boolean"
          },
          "credentialsNonExpired": {
            "type": "boolean"
          },
          "accountNonLocked": {
            "type": "boolean"
          }
        }
      },
      "CategorySelectionRequest": {
        "type": "object",
        "properties": {
          "selectedCategory": {
            "type": "string"
          },
          "sessionId": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "QuestionDTO": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "GameStateResponse": {
        "type": "object",
        "properties": {
          "playerIds": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int64"
            }
          },
          "currentQuestionIndex": {
            "type": "integer",
            "format": "int32"
          },
          "scores": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "format": "int32"
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "COMPLETED"
            ]
          }
        }
      }
    }
  }
}
