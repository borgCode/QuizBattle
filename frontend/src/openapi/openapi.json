{
  "openapi": "3.0.1",
  "info": {
    "title": "Your API Title",
    "description": "Your API Description",
    "version": "1.0"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Generated server url"
    }
  ],
  "paths": {
    "/player/update": {
      "put": {
        "tags": [
          "Player"
        ],
        "operationId": "updatePlayer",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdatePlayerRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/questions/validate-answer": {
      "post": {
        "tags": [
          "Questions"
        ],
        "operationId": "validateAnswer",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnswerValidationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    },
    "/auth/register": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "operationId": "register",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegistrationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/auth/authenticate": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "operationId": "authenticate",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/questions/{sessionId}/category-selection": {
      "get": {
        "tags": [
          "Questions"
        ],
        "operationId": "getThreeRandomCategories",
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/questions/session/{sessionId}": {
      "get": {
        "tags": [
          "Questions"
        ],
        "operationId": "getSessionQuestions",
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/QuestionDTO"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/questions/random-questions": {
      "get": {
        "tags": [
          "Questions"
        ],
        "operationId": "getThreeQuestionsByCategory",
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sessionId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/QuestionDTO"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/player/{username}": {
      "get": {
        "tags": [
          "Player"
        ],
        "operationId": "getPlayerById",
        "parameters": [
          {
            "name": "username",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlayerDTO"
                }
              }
            }
          }
        }
      }
    },
    "/multiplayer": {
      "get": {
        "tags": [
          "Multiplayer"
        ],
        "operationId": "findMatch",
        "parameters": [
          {
            "name": "request",
            "in": "query",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/MatchmakingRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MatchmakingResponse"
                }
              }
            }
          }
        }
      }
    },
    "/multiplayer/{playerId}": {
      "get": {
        "tags": [
          "Multiplayer"
        ],
        "operationId": "getPlayerSessions",
        "parameters": [
          {
            "name": "playerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MultiplayerSessionDTO"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/multiplayer/session/{sessionId}": {
      "get": {
        "tags": [
          "Multiplayer"
        ],
        "operationId": "getGameState",
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameStateResponse"
                }
              }
            }
          }
        }
      }
    },
    "/multiplayer/matchmaking/{playerId}": {
      "delete": {
        "tags": [
          "Multiplayer"
        ],
        "operationId": "cancelMatchmaking",
        "parameters": [
          {
            "name": "playerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "UpdatePlayerRequest": {
        "type": "object",
        "properties": {
          "playerId": {
            "type": "integer",
            "format": "int64"
          },
          "updateField": {
            "type": "string",
            "enum": [
              "USERNAME",
              "DISPLAY_NAME"
            ]
          },
          "newUsername": {
            "type": "string"
          },
          "newDisplayName": {
            "type": "string"
          }
        }
      },
      "AnswerValidationRequest": {
        "type": "object",
        "properties": {
          "questionId": {
            "type": "integer",
            "format": "int64"
          },
          "sessionId": {
            "type": "integer",
            "format": "int64"
          },
          "answer": {
            "type": "string"
          },
          "playerId": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "RegistrationRequest": {
        "required": [
          "displayName",
          "password",
          "username"
        ],
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          }
        }
      },
      "AuthRequest": {
        "required": [
          "password",
          "username"
        ],
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "AuthResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "playerDTO": {
            "$ref": "#/components/schemas/PlayerDTO"
          },
          "token": {
            "type": "string"
          }
        }
      },
      "PlayerDTO": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "username": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "numOfGames": {
            "type": "integer",
            "format": "int32"
          },
          "numOfWins": {
            "type": "integer",
            "format": "int32"
          },
          "numOfLosses": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "QuestionDTO": {
        "type": "object",
        "properties": {
          "questionId": {
            "type": "integer",
            "format": "int64"
          },
          "question": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "MatchmakingRequest": {
        "type": "object",
        "properties": {
          "playerId": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "MatchmakingResponse": {
        "type": "object",
        "properties": {
          "matchStatus": {
            "type": "string",
            "enum": [
              "WAITING",
              "MATCHED",
              "CANCELLED",
              "ERROR",
              "TIMEOUT"
            ]
          },
          "sessionId": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "MultiplayerSessionDTO": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "playerDTOList": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PlayerDTO"
            }
          },
          "score": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "format": "int32"
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "COMPLETED"
            ]
          },
          "currentPlayerTurn": {
            "$ref": "#/components/schemas/PlayerDTO"
          }
        }
      },
      "GameStateResponse": {
        "type": "object",
        "properties": {
          "playerTurn": {
            "type": "integer",
            "format": "int64"
          },
          "playerDTOS": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PlayerDTO"
            }
          },
          "currentQuestionIndex": {
            "type": "integer",
            "format": "int32"
          },
          "scores": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "format": "int32"
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "COMPLETED"
            ]
          },
          "results": {
            "uniqueItems": true,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PlayerQuestionResult"
            }
          }
        }
      },
      "PlayerQuestionResult": {
        "type": "object",
        "properties": {
          "playerId": {
            "type": "integer",
            "format": "int64"
          },
          "questionId": {
            "type": "integer",
            "format": "int64"
          },
          "questionIndex": {
            "type": "integer",
            "format": "int32"
          },
          "correct": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
