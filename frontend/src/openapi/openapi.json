        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "numOfGames": {
            "type": "integer",
            "format": "int32"
          },
          "numOfWins": {
            "type": "integer",
            "format": "int32"
          },
          "numOfLosses": {
            "type": "integer",
            "format": "int32"
          },
          "categoryStats": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/CategoryStats"
            }
          }
        }
      },
      "QuestionDTO": {
        "type": "object",
        "properties": {
          "questionId": {
            "type": "integer",
            "format": "int64"
          },
          "question": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "Notification": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "playerId": {
            "type": "integer",
            "format": "int64"
          },
          "senderId": {
            "type": "integer",
            "format": "int64"
          },
          "type": {
            "type": "string",
            "enum": [
              "FRIEND_REQUEST",
              "FRIEND_ACCEPTED",
              "REMATCH_REQUEST",
              "REMATCH_ACCEPTED",
              "GAME_WON",
              "GAME_LOST"
            ]
          },
          "pendingSessionId": {
            "type": "integer",
            "format": "int64"
          },
          "message": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "read": {
            "type": "boolean"
          }
        }
      },
      "MultiplayerSessionDTO": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "playerDTOList": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PlayerDTO"
            }
          },
          "score": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "format": "int32"
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "COMPLETED"
            ]
          },
          "currentPlayerTurn": {
            "$ref": "#/components/schemas/PlayerDTO"
          }
        }
      },
      "GameStateResponse": {
        "type": "object",
        "properties": {
          "playerTurn": {
            "type": "integer",
            "format": "int64"
          },
          "playerDTOS": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PlayerDTO"
            }
          },
          "currentQuestionIndex": {
            "type": "integer",
            "format": "int32"
          },
          "scores": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "format": "int32"
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "COMPLETED"
            ]
          },
          "results": {
            "uniqueItems": true,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PlayerQuestionResult"
            }
          },
          "questionIds": {
            "type": "array",
